BOT_TOKEN=123456:replace-me
# sqlite+aiosqlite:///./dating_bot.db  or  postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./dating_bot.db
# Optional persistent FSM storage (pip install redis)
REDIS_URL=

# Sponsor channel: numeric id (-100...) or @username. The bot must be a channel admin.
SPONSOR_CHANNEL_ID=
SPONSOR_CHANNEL_URL=

STARTING_BALANCE=30
PRICE_VIEW_PHOTOS_ONLY=2
PRICE_VIEW_BIO_ONLY=1
PRICE_VIEW_FULL_PROFILE=3
PRICE_SEND_ANON_MSG=5
PRICE_SEND_NAMED_MSG=3
PRICE_REQUEST_PM=15
REFUND_ON_PM_REJECT=true
# [[coins, stars], ...]
COIN_PACKAGES=[[50,25],[150,65],[500,200]]
# true = credit top-ups without payment (development only)
PAYMENTS_MOCK=false
